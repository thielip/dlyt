REDIS_URL=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TMP_DIR=./tmp/dlyt
TASK_TTL_SECONDS=3600
FILE_TTL_SECONDS=1800
FILE_GRACE_SECONDS=300
MAX_FILESIZE_BYTES=0
MAX_DURATION_SECONDS=0
MIN_FREE_DISK_BYTES=209715200
RATE_LIMIT_PER_MINUTE=30
PUBLIC_BASE_URL=
MAX_CONCURRENT_DOWNLOADS=2
MAX_ACTIVE_TASKS_PER_IP=2
DOWNLOAD_TIMEOUT_SECONDS=1200
INFO_WORKERS=4
INFO_CACHE_TTL_SECONDS=180
FAIL_CACHE_TTL_SECONDS=45
# Stop probing extra YouTube player clients for captions after this many seconds.
# Each attempt costs ~15-20s through WARP; 0 disables the budget (probe all clients).
EXTRACT_BUDGET_SECONDS=20
CANARY_URL=https://www.youtube.com/watch?v=jNQXAC9IVRw
SENTRY_DSN=
LOG_JSON=true
MAINTENANCE_MODE=false
PREFER_DIRECT_DOWNLOAD=true
ALLOW_PROXY_FALLBACK=true
# Cloudflare WARP (userspace wireproxy). start.sh sets YTDLP_PROXY when ready.
ENABLE_WARP=true
# Optional override, e.g. socks5://127.0.0.1:1080 — leave empty to use start.sh / env
YTDLP_PROXY=
MAX_MONTHLY_OUTBOUND_BYTES=96636764160
OUTBOUND_SOFT_RATIO=0.70
OUTBOUND_HARD_RATIO=0.92
MAX_PROXY_HEIGHT=1080
# Upstash free allows ~10k commands/day. Render Key Value has no such cap — raise this
# (e.g. 500000) when hosting Redis on Render, or the cache soft-degrades to memory.
REDIS_MAX_COMMANDS_PER_DAY=8000
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false
MAX_ASR_DURATION_SECONDS=0
ASR_TIMEOUT_SECONDS=1800
GEMINI_ASR_MODEL=gemini-2.5-flash
GEMINI_INLINE_MAX_BYTES=18874368
